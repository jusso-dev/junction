        <NavigationProperty Name="reports" Type="Collection(self.User)"/>
      </EntityType>
      <Action Name="Reset">
        <Parameter Name="name" Type="Edm.String" Nullable="false" MaxLength="10"/>
        <Parameter Name="targets" Type="Collection(self.User)" Nullable="false"/>
        <ReturnType Type="Edm.Boolean" Nullable="false"/>
      </Action>
      <EntityContainer Name="Service">
        <EntitySet Name="users" EntityType="self.User"/>
        <Singleton Name="me" Type="self.User"/>
        <EntitySet Name="hidden" EntityType="self.User">
          <Annotation Term="Caps.ReadRestrictions"><Record><PropertyValue Property="Readable" Bool="false"/></Record></Annotation>
        </EntitySet>
        <EntitySet Name="externalHidden" EntityType="self.User"/>
        <ActionImport Name="reset" Action="self.Reset"/>
      </EntityContainer>
      <Annotations Target="self.Service/externalHidden">
        <Annotation Term="Caps.ReadRestrictions"><Record><PropertyValue Property="Readable"><Bool>false</Bool></PropertyValue></Record></Annotation>
      </Annotations>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
