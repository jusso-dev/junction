    <edmx:Include Namespace="Org.OData.Capabilities.V1" Alias="Caps" />
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="Demo" Alias="self" xmlns="http://docs.oasis-open.org/odata/ns/edm">
