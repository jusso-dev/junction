        <Property Name="city" Type="Edm.String" Nullable="false" MaxLength="30"/>
      </ComplexType>
      <EntityType Name="Base">
        <Key><PropertyRef Name="id"/></Key>
        <Property Name="id" Type="Edm.Guid" Nullable="false"/>
      </EntityType>
      <EntityType Name="User" BaseType="self.Base">
