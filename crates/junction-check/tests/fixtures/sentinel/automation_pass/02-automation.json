                        "email": "oncall@contoso.example"
                      }
                    }
                  }
                ]
              }
            },
            {
              "id": "/subscriptions/00000000-0000-4000-8000-0000000000a1/resourceGroups/rg-security/providers/Microsoft.OperationalInsights/workspaces/law-sentinel-01/providers/Microsoft.SecurityInsights/automationRules/auto-3",
              "name": "auto-3",
              "type": "Microsoft.SecurityInsights/automationRules",
              "properties": {
                "displayName": "Page on-call",
                "order": 3,
                "triggeringLogic": {
                  "isEnabled": true,
                  "triggersOn": "Incidents",
