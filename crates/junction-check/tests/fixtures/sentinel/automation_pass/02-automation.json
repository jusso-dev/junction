                    "actionType": "RunPlaybook",
                    "actionConfiguration": {
                      "logicAppResourceId": "/subscriptions/00000000-0000-4000-8000-0000000000a1/resourceGroups/rg-security/providers/Microsoft.Logic/workflows/notify-oncall",
                      "tenantId": "00000000-0000-4000-8000-000000000001"
